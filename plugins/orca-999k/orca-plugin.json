{
  "manifestVersion": 2,
  "id": "radio999k",
  "name": "999K",
  "version": "0.2.0",
  "description": "Open 999K bot setup in a local Orca terminal.",
  "author": { "name": "999K" },
  "license": "MIT",
  "engines": { "orca": ">=1.4.268" },
  "execution": "trusted-worker",
  "main": "worker.ts",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" }
  ],
  "contributes": {
    "panels": [
      {
        "id": "setup",
        "title": "999K",
        "icon": "activity",
        "entry": "panel.tsx",
        "ui": "components"
      }
    ]
  }
}
